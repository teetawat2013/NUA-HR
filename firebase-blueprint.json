{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile and account metadata",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 256 },
        "displayName": { "type": "string", "maxLength": 128 },
        "photoURL": { "type": "string", "maxLength": 512 },
        "createdAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["uid", "email"]
    },
    "Employee": {
      "title": "Employee",
      "description": "Employee profile record containing demographics, foreign worker document details, and resignation state",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64 },
        "userId": { "type": "string", "maxLength": 128 },
        "prefix": { "type": "string", "maxLength": 32 },
        "fullName": { "type": "string", "maxLength": 128 },
        "nickname": { "type": "string", "maxLength": 64 },
        "gender": { "type": "string", "maxLength": 32 },
        "idCardNumber": { "type": "string", "maxLength": 64 },
        "department": { "type": "string", "maxLength": 64 },
        "position": { "type": "string", "maxLength": 64 },
        "branch": { "type": "string", "maxLength": 64 },
        "phoneNumber": { "type": "string", "maxLength": 32 },
        "email": { "type": "string", "maxLength": 128 },
        "startDate": { "type": "string", "maxLength": 32 },
        "employmentType": { "type": "string", "maxLength": 32 },
        "status": { "type": "string", "maxLength": 32 },
        "createdAt": { "type": "string", "maxLength": 64 },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "userId", "fullName"]
    },
    "AttendanceRecord": {
      "title": "AttendanceRecord",
      "description": "Individual attendance, leave, or overtime log entry",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64 },
        "userId": { "type": "string", "maxLength": 128 },
        "employeeId": { "type": "string", "maxLength": 64 },
        "employeeName": { "type": "string", "maxLength": 128 },
        "department": { "type": "string", "maxLength": 64 },
        "date": { "type": "string", "maxLength": 32 },
        "type": { "type": "string", "maxLength": 32 },
        "amount": { "type": "number" },
        "reason": { "type": "string", "maxLength": 256 },
        "createdAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "userId", "employeeId", "date", "type"]
    },
    "ReportHistoryItem": {
      "title": "ReportHistoryItem",
      "description": "Archived monthly executive attendance & payroll summary report record",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64 },
        "userId": { "type": "string", "maxLength": 128 },
        "reportTitle": { "type": "string", "maxLength": 256 },
        "month": { "type": "number" },
        "year": { "type": "number" },
        "generatedAt": { "type": "string", "maxLength": 64 },
        "employeeCount": { "type": "number" },
        "thaiCount": { "type": "number" },
        "foreignCount": { "type": "number" },
        "fileFormat": { "type": "string", "maxLength": 32 }
      },
      "required": ["id", "userId", "reportTitle", "month", "year", "generatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Master user profile record"
    },
    "/users/{userId}/employees/{employeeId}": {
      "schema": "Employee",
      "description": "Subcollection of employee records managed by the authenticated user"
    },
    "/users/{userId}/attendance_records/{recordId}": {
      "schema": "AttendanceRecord",
      "description": "Subcollection of attendance records managed by the authenticated user"
    },
    "/users/{userId}/report_history/{reportId}": {
      "schema": "ReportHistoryItem",
      "description": "Subcollection of archived monthly reports generated by the authenticated user"
    }
  }
}
