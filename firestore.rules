rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Global Default-Deny Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() &&
        (request.auth.token.email.lower() == 'teetawat2013@gmail.com' ||
         request.auth.token.email == 'Teetawat2013@gmail.com') &&
        request.auth.token.email_verified == true;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // User profile validation
    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid', 'email']) &&
        data.uid is string && data.uid.size() <= 128 &&
        data.email is string && data.email.size() <= 256;
    }

    // Employee validation
    function isValidEmployee(data) {
      return data.keys().hasAll(['id', 'userId', 'fullName']) &&
        data.id is string && data.id.size() <= 64 &&
        data.userId is string && data.userId.size() <= 128 &&
        data.fullName is string && data.fullName.size() <= 128;
    }

    // Attendance record validation
    function isValidAttendanceRecord(data) {
      return data.keys().hasAll(['id', 'userId', 'employeeId', 'date', 'type']) &&
        data.id is string && data.id.size() <= 64 &&
        data.userId is string && data.userId.size() <= 128 &&
        data.employeeId is string && data.employeeId.size() <= 64 &&
        data.date is string && data.date.size() <= 32 &&
        data.type is string && data.type.size() <= 32;
    }

    // Report history item validation
    function isValidReportHistory(data) {
      return data.keys().hasAll(['id', 'userId', 'reportTitle', 'month', 'year', 'generatedAt']) &&
        data.id is string && data.id.size() <= 64 &&
        data.userId is string && data.userId.size() <= 128 &&
        data.reportTitle is string && data.reportTitle.size() <= 256 &&
        data.month is number &&
        data.year is number &&
        data.generatedAt is string && data.generatedAt.size() <= 64;
    }

    // Document template validation (.docx เก็บเป็น base64 ต้องไม่เกินเพดานเอกสาร Firestore)
    function isValidDocTemplate(data) {
      return data.keys().hasAll(['id', 'userId', 'name', 'fileName', 'contentBase64']) &&
        data.id is string && data.id.size() <= 64 &&
        data.userId is string && data.userId.size() <= 128 &&
        data.name is string && data.name.size() > 0 && data.name.size() <= 200 &&
        data.fileName is string && data.fileName.size() <= 256 &&
        data.contentBase64 is string && data.contentBase64.size() <= 950000;
    }

    // Generated document log validation
    function isValidGeneratedDoc(data) {
      return data.keys().hasAll(['id', 'userId', 'templateId', 'employeeId', 'generatedAt']) &&
        data.id is string && data.id.size() <= 64 &&
        data.userId is string && data.userId.size() <= 128 &&
        data.templateId is string && data.templateId.size() <= 64 &&
        data.employeeId is string && data.employeeId.size() <= 64 &&
        data.generatedAt is string && data.generatedAt.size() <= 64;
    }

    // Job application validation
    function isValidJobApplication(data) {
      return data.keys().hasAll(['id', 'fullName', 'position', 'appliedAt', 'status']) &&
        data.id is string && data.id.size() <= 64 &&
        data.fullName is string && data.fullName.size() <= 128 &&
        data.position is string && data.position.size() <= 128 &&
        data.appliedAt is string && data.appliedAt.size() <= 64 &&
        data.status is string && data.status.size() <= 32;
    }

    // Public / Shared Job Settings & Applications collection
    match /job_applications/{applicationId} {
      allow get, list: if isSignedIn();
      allow create: if isValidId(applicationId) && isValidJobApplication(incoming());
      allow update, delete: if isSignedIn();
    }

    match /job_settings/{settingId} {
      allow get, list: if true;
      allow create, update, delete: if isSignedIn();
    }

    // Match rules for Users collection
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create, update: if (isOwner(userId) || isAdmin()) && isValidUserProfile(incoming());
      allow delete: if isAdmin();

      // Subcollection: employees
      match /employees/{employeeId} {
        allow get, list: if isOwner(userId) || isAdmin();
        allow create: if (isOwner(userId) || isAdmin()) &&
          isValidId(employeeId) &&
          incoming().userId == userId &&
          isValidEmployee(incoming());
        allow update: if (isOwner(userId) || isAdmin()) &&
          isValidId(employeeId) &&
          incoming().userId == existing().userId &&
          isValidEmployee(incoming());
        allow delete: if (isOwner(userId) || isAdmin()) && isValidId(employeeId);
      }

      // Subcollection: attendance records
      match /attendance_records/{recordId} {
        allow get, list: if isOwner(userId) || isAdmin();
        allow create: if (isOwner(userId) || isAdmin()) &&
          isValidId(recordId) &&
          incoming().userId == userId &&
          isValidAttendanceRecord(incoming());
        allow update: if (isOwner(userId) || isAdmin()) &&
          isValidId(recordId) &&
          incoming().userId == existing().userId &&
          isValidAttendanceRecord(incoming());
        allow delete: if (isOwner(userId) || isAdmin()) && isValidId(recordId);
      }

      // Subcollection: document templates (คลังเอกสาร)
      match /doc_templates/{templateId} {
        allow get, list: if isOwner(userId) || isAdmin();
        allow create: if (isOwner(userId) || isAdmin()) &&
          isValidId(templateId) &&
          incoming().userId == userId &&
          isValidDocTemplate(incoming());
        allow update: if (isOwner(userId) || isAdmin()) &&
          isValidId(templateId) &&
          incoming().userId == existing().userId &&
          isValidDocTemplate(incoming());
        allow delete: if (isOwner(userId) || isAdmin()) && isValidId(templateId);
      }

      // Subcollection: generated documents log
      match /generated_documents/{recordId} {
        allow get, list: if isOwner(userId) || isAdmin();
        allow create: if (isOwner(userId) || isAdmin()) &&
          isValidId(recordId) &&
          incoming().userId == userId &&
          isValidGeneratedDoc(incoming());
        allow update: if (isOwner(userId) || isAdmin()) &&
          isValidId(recordId) &&
          incoming().userId == existing().userId &&
          isValidGeneratedDoc(incoming());
        allow delete: if (isOwner(userId) || isAdmin()) && isValidId(recordId);
      }

      // Subcollection: report history
      match /report_history/{reportId} {
        allow get, list: if isOwner(userId) || isAdmin();
        allow create: if (isOwner(userId) || isAdmin()) &&
          isValidId(reportId) &&
          incoming().userId == userId &&
          isValidReportHistory(incoming());
        allow update: if (isOwner(userId) || isAdmin()) &&
          isValidId(reportId) &&
          incoming().userId == existing().userId &&
          isValidReportHistory(incoming());
        allow delete: if (isOwner(userId) || isAdmin()) && isValidId(reportId);
      }
    }
  }
}
